# If you want to suggest changes, please send PR on
# https://altlinux.space/alt-atomic/apm to altlinux branch

%define _unpackaged_files_terminate_build 1

%define libname lib%name
%define gir_name Apm
%define service_id org.altlinux.APM

%define sover 0.8

Name: apm
Version: @VERSION@
Release: alt@RELEASE@

Summary: Atomic Package Manager
License: GPL-3.0-or-later
Group: System/Configuration/Packaging
URL: https://altlinux.space/alt-atomic/apm
VCS: https://altlinux.space/alt-atomic/apm.git

ExclusiveArch: %go_arches

Source: %name-%version.tar

# From v0.1.3 distrobox in optional requires
# Requires: distrobox

BuildRequires(pre): rpm-macros-golang
BuildRequires(pre): rpm-macros-systemd
BuildRequires(pre): rpm-macros-meson
BuildRequires: rpm-build-golang
BuildRequires: rpm-build-vala
BuildRequires: meson
BuildRequires: gcc-c++
BuildRequires: libapt-devel
BuildRequires: pkgconfig(appstream)
BuildRequires: vala
BuildRequires: pkgconfig(libdeser-0.2)
BuildRequires: gobject-introspection-devel
BuildRequires: gir(Deser) = 0.2
BuildRequires: pkgconfig(systemd)
BuildRequires: /proc

%description
APM is a universal application for managing both system packages
and packages from distrobox. It consolidates all functions into
a single API, provides interaction via a DBUS service, and offers
optional support for atomic images based on ALT Linux.

%package -n %libname%sover
Summary: DBus library of %name
Group: System/Libraries

%description -n %libname%sover
%summary.

%package -n %libname%sover-devel
Summary: Development files for DBus library of %name
Group: Development/Other

%description -n %libname%sover-devel
%summary.

%prep
%setup

# Fix go vendoring build
for file in $(find -name "*\[generated\]*"); do
  mv -v "$file" "${file//\[generated\]/}"
done

%build
%meson -Dprofile=dev
%meson_build

%install
%meson_install

%find_lang %name

%files -f %name.lang
%_localstatedir/%name
%_cachedir/%name
%_sysconfdir/%name
%_tmpfilesdir/%name.conf
%_bindir/%name
%_sysconfdir/dbus-1/system.d/%service_id.conf
%_unitdir/%name.service
%_datadir/dbus-1/services/%service_id.User.service
%_datadir/dbus-1/system-services/%service_id.service
%_datadir/bash-completion/completions/%name
%_datadir/fish/vendor_completions.d/%name.fish
%_datadir/zsh/site-functions/_%name
%_datadir/polkit-1/actions/%service_id.policy
%_sysconfdir/apt/apt.conf.d/99-apm-update.conf
%_datadir/apt/scripts/update-apm.lua
%_datadir/%name/grpconf.d
%doc README*

%files -n %libname%sover
%_libdir/%libname.so.%sover
%_libdir/%libname.so.%sover.*
%_typelibdir/%gir_name-%sover.typelib

%files -n %libname%sover-devel
%_libdir/%libname.so
%_includedir/%libname-%sover.h
%_pkgconfigdir/%libname-%sover.pc
%_vapidir/%libname-%sover.vapi
%_vapidir/%libname-%sover.deps
%_girdir/%gir_name-%sover.gir
