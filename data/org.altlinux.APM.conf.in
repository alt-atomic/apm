<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <policy user="@USER@">
    <allow own="@SERVICE_ID@"/>
  </policy>

  <policy context="default">
    <allow send_destination="@SERVICE_ID@" send_interface="@SERVICE_ID@2.Packages"/>
    <allow send_destination="@SERVICE_ID@" send_interface="@SERVICE_ID@2.Image"/>
    <allow send_destination="@SERVICE_ID@" send_interface="@SERVICE_ID@2.Applications"/>
    <allow send_destination="@SERVICE_ID@" send_interface="@SERVICE_ID@2.Kernel"/>
    <allow send_destination="@SERVICE_ID@" send_interface="@SERVICE_ID@2.Repo"/>
    <allow send_destination="@SERVICE_ID@" send_interface="@SERVICE_ID@2.Jobs"/>
    <allow send_destination="@SERVICE_ID@" send_interface="org.freedesktop.DBus.Properties"/>
    <allow send_destination="@SERVICE_ID@" send_interface="org.freedesktop.DBus.Introspectable"/>
  </policy>
</busconfig>
